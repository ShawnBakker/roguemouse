# Vultr Serverless Inference
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_OPS_MODEL=nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-BF16

# Vultr Object Storage (S3-compatible)
S3_ENDPOINT=https://ams1.vultrobjects.com
S3_REGION=ams1
S3_BUCKET=roguemouse-audit-log
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Google Gemini (Risk Officer voice + Synthesizer)
GEMINI_API_KEY=
GEMINI_RISK_MODEL=gemini-2.5-pro
GEMINI_SYNTH_MODEL=gemini-2.5-flash

# Application
NODE_ENV=development
LOG_LEVEL=info
